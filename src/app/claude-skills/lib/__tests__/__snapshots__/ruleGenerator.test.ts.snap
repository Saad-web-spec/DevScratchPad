exports[`buildRuleContent > matches the committed snapshot for the first preset > claudeignore 1`] = `
"# .claudeignore - Claude Code CLI Privacy & Boundary Protection
# Prevents Claude Code CLI from indexing and modifying sensitive credentials, build caches, and bulky lockfiles.
# Keeping your agent boundary clean improves reasoning quality and prevents data leaks.

# --- Critical: Secrets & Local Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets/
credentials/
service-account*.json
*.p12
*.pfx
*.keystore

# --- Dependency Bloat & Massive Lockfiles (Saves 50k+ tokens) ---
node_modules/
vendor/
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lockb
poetry.lock
Pipfile.lock
Cargo.lock
composer.lock
go.sum

# --- Build Artifacts, Bundler & Framework Caches ---
dist/
build/
out/
.cache/
*.tsbuildinfo
.next/
.turbo/
.vercel/
.nuxt/
.output/
.svelte-kit/
coverage/

# --- Large Binary Files & Media (Never needed by LLM) ---
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.mp4
*.webm
*.mp3
*.wav
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.pdf
*.wasm

# --- Test Coverage & Debug Logs ---
coverage/
.nyc_output/
*.lcov
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Editor Metadata & OS Caches ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Database Dumps & Local SQLite Storage ---
*.sql
*.dump
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# --- Heavy Test Fixtures & Snapshots ---
test/fixtures/large/
tests/fixtures/
__snapshots__/
fixtures/**/*.json
mock-data/**/*.json
"
`;

